        <img src="https://hatscripts.github.io/circle-flags/flags/fr.svg" alt="FR" />
      </a>
    </div>
    <div class="flag-image">
      <a href="https://www.amazon.it/stores/page/3E8E9F0A-6CCE-46FF-95CD-D118F6B75BD6?maas=maas_adg_769F1D0DC860348A04423D5DE1ECA4D2_afap_abs&ref_=aa_maas&tag=maas&ingress=3">
        <img src="https://hatscripts.github.io/circle-flags/flags/it.svg" alt="IT" />
      </a>
    </div>
    <div class="flag-image">
      <a href="https://www.amazon.es/stores/page/5A919E3F-9901-4A60-B109-B48DECEF5694?maas=maas_adg_6A47C50E29CC497763C2287FE07CE770_afap_abs&ref_=aa_maas&tag=maas&channel=GCX">
