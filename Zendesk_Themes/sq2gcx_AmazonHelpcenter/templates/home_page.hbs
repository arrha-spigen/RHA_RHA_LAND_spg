  <a class="spigen-store-link" href="https://www.amazon.co.uk/stores/page/9ACCFF27-B9B7-4FC8-8A01-A936CA988E0C">Visit Store</a>
</div>

<div class="instagram-feed">
  <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/spigenuk/?hl=ko" data-instgrm-version="12" style="width:100%; max-width:540px; margin:0 auto;">
  </blockquote>
</div>

<!-- Scripts -->
<script>
  // YouTube API initialization
  (function () {
    var tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    var firstScriptTag = document.getElementsByTagName('script')[0];
    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
  })();

  var player;
  var videoIds = ['KwYuPA7_ZBk', 'VnDFLfBSrAk'];
  var currentVideo = 0;

  function onYouTubeIframeAPIReady() {
    player = new YT.Player('youtubePlayer', {
      width: '100%',
      height: '100%',
      videoId: videoIds[0],
      playerVars: {
        autoplay: 1,
        mute: 1,
        controls: 0,
        rel: 0,
        modestbranding: 1,
        playsinline: 1
      },
      events: {
        onStateChange: onPlayerStateChange
      }
    });
  }

  function onPlayerStateChange(event) {
    if (event.data === YT.PlayerState.ENDED) {
      if (currentVideo < videoIds.length - 1) {
        currentVideo += 1;
        player.loadVideoById(videoIds[currentVideo]);
      } else {
        currentVideo = 0;
        player.loadVideoById(videoIds[currentVideo]);
      }
    }
  }

  (function () {
    var userLang = window.navigator.language || window.navigator.userLanguage || '';
    var domain = 'co.uk'; // Default marketplace for EU Zendesk domain

    if (userLang.match(/de/i)) {
      domain = 'de';
    } else if (userLang.match(/fr/i)) {
      domain = 'fr';
    } else if (userLang.match(/it/i)) {
      domain = 'it';
    } else if (userLang.match(/es/i)) {
      domain = 'es';
    } else if (userLang.match(/ja|jp/i)) {
      domain = 'co.jp';
    } else if (userLang.match(/en-US/i)) {
      domain = 'com';
    }

    var localStoreUrl = 'https://www.amazon.' + domain + '/stores/page/9ACCFF27-B9B7-4FC8-8A01-A936CA988E0C';
    var links = document.querySelectorAll('.spigen-store-link');
    links.forEach(function (link) {
      link.href = localStoreUrl;
    });
  })();
</script>

</body>
</html>