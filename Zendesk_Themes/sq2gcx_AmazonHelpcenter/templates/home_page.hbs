<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Fixed Layout Example</title>
<style>
body {
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  font-family: Arial, sans-serif;
}
.flags-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  border: 2px solid #ddd;
  padding: 10px;
  border-radius: 10px;
  background-color: #fff;
}
.logo-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}
.amazon-logo { width: 80px; margin-right: 10px; }
.link-text { font-size: 16px; color: #333; font-weight: bold; }
.flag-images {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}
.flag-image { margin: 5px; }
.flag-image img { width: 40px; cursor: pointer; }

.video-container {
  width: 100%;
  max-width: 800px;
  margin-bottom: 20px;
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  background: #000;
}
.video-container iframe,
.video-container #youtubePlayer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

.promo-article {
  width: 100%;
  max-width: 800px;
  text-align: center;
  margin-top: 20px;
  padding: 20px;
  border: 1px solid #ddd;
  border-radius: 10px;
  box-shadow: 0 0 10px rgba(0,0,0,0.1);
  margin-bottom: 40px;
  overflow: hidden;
  box-sizing: border-box;
}
.promo-article a { color: #007BFF; text-decoration: none; }
.promo-article a:hover { text-decoration: underline; }
.image-container img {
  width: 100%;
  height: auto;
  border-radius: 10px;
  box-shadow: 0 0 10px rgba(0,0,0,0.1);
  transition: transform 0.3s ease;
}

.instagram-feed {
  width: 100%;
  max-width: 540px;
  margin: 0 auto;
  text-align: center;
}

.puzzle-container {
  display: grid;
  grid-template-columns: repeat(4, 100px);
  grid-gap: 5px;
  position: relative;
  margin: 40px auto;
  width: 420px;
  height: 420px;
  background: #fff;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  border-radius: 10px;
  transition: border 0.5s ease;
}
.puzzle-container.completed { border: 5px solid red; }
.puzzle-container.completed::after {
  content: "Puzzle Completed!";
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  font-size: 24px; font-weight: bold; color: #fff;
  background: rgba(0,0,0,0.8);
  padding: 20px 40px; border-radius: 10px; text-align: center; z-index: 10;
}
.puzzle-container div {
  width: 100px; height: 100px; border: 1px solid #ddd;
  display: flex; align-items: center; justify-content: center;
  background: #f0f0f0; cursor: grab;
}
.puzzle-piece {
  width: 100%; height: 100%;
  background-size: 400px 400px; background-position: center; background-repeat: no-repeat;
}
.original-image-container {
  margin-top: 20px; text-align: center;
}
.original-image-container img {
  max-width: 200px; border-radius: 10px;
  box-shadow: 0 4px 6px rgba(0,0,0,0.2);
}
</style>
<script async src="https://www.instagram.com/embed.js"></script>
</head>
<body>

<!-- Flags / store links -->
<div class="flags-container">
  <div class="logo-container">
    <img src="https://upload.wikimedia.org/wikipedia/commons/a/a9/Amazon_logo.svg" alt="Amazon Logo" class="amazon-logo" />
    <div class="link-text">Shop Now</div>
  </div>
  <div class="flag-images">
    <div class="flag-image">
